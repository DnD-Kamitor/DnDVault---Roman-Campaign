<!-- S2 Equipment Cache — interactive prop, not a combatant -->
[h: tokenName = getName()]
[dialog("Equipment Cache", "width=340; height=220; temporary=true;")]
<html><head><style>
  body{font-family:Georgia,serif;background:#0a0a1a;color:#e0e0e0;padding:12px;margin:0}
  h2{color:#8B8000;margin:0 0 6px 0;font-size:15px;border-bottom:1px solid #8B8000;padding-bottom:4px}
  .it{background:#1a1a00;border:1px solid #8B8000;border-radius:4px;padding:10px;margin-bottom:6px;font-size:13px}
</style></head><body>
<h2>&#128736; EQUIPMENT CACHE — [r: tokenName]</h2>
<div class="it">Investigation DC 12 — reveals contents</div>
<div class="it">Contents (GM chooses): spare weapons, rations, coin purse (2d6 sp), rolled orders, medical kit</div>
<div class="it">Perception DC 15 — notices it's been recently disturbed (Tribune Lucius searched it)</div>
</body></html>
[/dialog]
